generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  active
  suspended
}

enum CompanyPlan {
  trial
  free
  paid
}

enum UserStatus {
  active
  invited
  disabled
}

enum ProductStatus {
  active
  inactive
}

enum SalesOrderStatus {
  draft
  confirmed
  cancelled
  completed
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum InvoiceStatus {
  draft
  issued
  partial
  paid
  cancelled
}

enum VendorStatus {
  active
  inactive
  blocked
}

enum PurchaseOrderStatus {
  draft
  pending_approval
  approved
  rejected
  ordered
  received
  cancelled
}

enum FinanceAccountType {
  asset
  liability
  equity
  income
  expense
}

enum FinanceAccountKind {
  general
  cash
  bank
  mobile_money
}

enum FinanceAccountStatus {
  active
  inactive
}

enum JournalEntryStatus {
  draft
  posted
  cancelled
}

enum JournalSourceType {
  manual
  sales_order
  purchase_order
  pos_sale
}

enum SettlementStatus {
  open
  partial
  paid
  cancelled
}

enum FinancePeriodStatus {
  open
  closed
}

enum FinancePaymentMethod {
  cash
  bank_transfer
  card
  cheque
  mobile_money
  other
}

enum ExpenseStatus {
  posted
  reversed
}

enum PosSaleStatus {
  completed
  cancelled
}

enum PosSessionStatus {
  open
  closed
}

enum StockLedgerEntryType {
  opening_balance
  manual_adjustment
  sales_order_confirm
  sales_order_cancel
  purchase_order_receive
  purchase_order_cancel
  pos_sale_complete
  pos_sale_cancel
}

enum StockLedgerSourceType {
  product
  sales_order
  purchase_order
  pos_sale
}

enum LeadStage {
  new
  contacted
  qualified
  proposal
  won
  lost
}

enum LeadStatus {
  active
  converted
  archived
}

enum CustomerStatus {
  active
  inactive
  archived
}

enum LeadActivityType {
  call
  email
  whatsapp
  meeting
  note
  stage_change
  conversion
  archive
}

enum DealStatus {
  active
  won
  lost
  archived
  cancelled
}

enum SalesTaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum SalesTaskPriority {
  low
  medium
  high
  urgent
}

model Company {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  status          CompanyStatus @default(active)
  plan            CompanyPlan   @default(trial)
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users              User[]
  roles              Role[]
  products           Product[]
  salesQuotations    SalesQuotation[]
  salesInvoices      SalesInvoice[]
  salesOrders        SalesOrder[]
  posSales           PosSale[]
  posSessions        PosSession[]
  vendors            Vendor[]
  purchaseOrders     PurchaseOrder[]
  financeAccounts    FinanceAccount[]
  journalEntries     JournalEntry[]
  receivables        Receivable[]
  payables           Payable[]
  financePeriods     FinancePeriod[]
  expenses           Expense[]
  receivablePayments ReceivablePayment[]
  payablePayments    PayablePayment[]
  journalReversals   JournalReversal[]
  stockLedgerEntries StockLedgerEntry[]
  auditLogs          AuditLog[]
  leads              Lead[]
  customerContacts   CustomerContact[]
  leadActivities     LeadActivity[]
  pipelineStages     PipelineStage[]
  deals              Deal[]
  dealStageHistory   DealStageHistory[]
  salesTasks         SalesTask[]

  @@index([status])
}

model Product {
  id            String        @id @default(cuid())
  companyId     String
  name          String
  sku           String
  category      String?
  salePrice     Decimal       @db.Decimal(12, 2)
  costPrice     Decimal?      @db.Decimal(12, 2)
  stockQuantity Int           @default(0)
  status        ProductStatus @default(active)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  salesQuotationItems SalesQuotationItem[]
  salesInvoiceItems   SalesInvoiceItem[]
  salesOrderItems     SalesOrderItem[]
  posSaleItems        PosSaleItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  stockLedgerEntries  StockLedgerEntry[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([status])
  @@index([companyId, name])
  @@index([companyId, status, sku])
  @@index([companyId, status, name])
  @@index([companyId, status, category])
}

model SalesOrder {
  id              String           @id @default(cuid())
  companyId       String
  orderNumber     String
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  status          SalesOrderStatus @default(draft)
  subtotal        Decimal          @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal          @db.Decimal(12, 2)
  notes           String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company    Company          @relation(fields: [companyId], references: [id])
  quotations SalesQuotation[]
  invoices   SalesInvoice[]
  items      SalesOrderItem[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model SalesOrderItem {
  id                  String   @id @default(cuid())
  salesOrderId        String
  productId           String
  productNameSnapshot String
  productSkuSnapshot  String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
}

model PosSale {
  id                    String               @id @default(cuid())
  companyId             String
  saleNumber            String
  customerNameSnapshot  String?
  customerPhoneSnapshot String?
  status                PosSaleStatus        @default(completed)
  subtotal              Decimal              @db.Decimal(12, 2)
  discountAmount        Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal              @db.Decimal(12, 2)
  paidAmount            Decimal              @db.Decimal(12, 2)
  changeAmount          Decimal              @default(0) @db.Decimal(12, 2)
  paymentMethod         FinancePaymentMethod @default(cash)
  paymentAccountId      String?
  posSessionId          String?
  salesOrderId          String?
  receivableId          String?
  journalEntryId        String?
  cashierUserId         String?
  completedAt           DateTime             @default(now())
  cancelledAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  cashierUser    User?           @relation("PosSaleCashier", fields: [cashierUserId], references: [id], onDelete: SetNull)
  paymentAccount FinanceAccount? @relation("PosSalePaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  posSession     PosSession?     @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  items          PosSaleItem[]

  @@unique([companyId, saleNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, completedAt])
  @@index([cashierUserId])
  @@index([paymentAccountId])
  @@index([posSessionId])
}

model PosSession {
  id           String           @id @default(cuid())
  companyId    String
  cashierUserId String
  counterName  String?
  status       PosSessionStatus @default(open)
  openingFloat Decimal          @default(0) @db.Decimal(12, 2)
  closingCash  Decimal?         @db.Decimal(12, 2)
  expectedCash Decimal?         @db.Decimal(12, 2)
  variance     Decimal?         @db.Decimal(12, 2)
  openedAt     DateTime         @default(now())
  closedAt     DateTime?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company     Company   @relation(fields: [companyId], references: [id])
  cashierUser User      @relation("PosSessionCashier", fields: [cashierUserId], references: [id])
  sales       PosSale[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([cashierUserId])
  @@index([companyId, cashierUserId, status])
  @@index([openedAt])
  @@index([closedAt])
}

model PosSaleItem {
  id                  String   @id @default(cuid())
  posSaleId           String
  productId           String
  productNameSnapshot String
  productSkuSnapshot  String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  posSale PosSale @relation(fields: [posSaleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([posSaleId])
  @@index([productId])
}

model SalesQuotation {
  id              String          @id @default(cuid())
  companyId       String
  salesOrderId    String?
  quoteNumber     String
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  status          QuotationStatus @default(draft)
  validUntil      DateTime?
  subtotal        Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  notes           String?
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  expiredAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company    Company              @relation(fields: [companyId], references: [id])
  salesOrder SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  items      SalesQuotationItem[]
  invoices   SalesInvoice[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([salesOrderId])
  @@index([status])
  @@index([createdAt])
}

model SalesQuotationItem {
  id                  String   @id @default(cuid())
  quotationId         String
  productId           String
  productNameSnapshot String
  productSkuSnapshot  String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  quotation SalesQuotation @relation(fields: [quotationId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}

model SalesInvoice {
  id                      String        @id @default(cuid())
  companyId               String
  salesOrderId            String        @unique
  quotationId             String?
  receivableId            String?       @unique
  invoiceNumber           String
  customerNameSnapshot    String
  customerPhoneSnapshot   String?
  customerEmailSnapshot   String?
  customerAddressSnapshot String?
  status                  InvoiceStatus @default(draft)
  invoiceDate             DateTime      @default(now())
  dueDate                 DateTime?
  subtotal                Decimal       @db.Decimal(12, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal       @db.Decimal(12, 2)
  notes                   String?
  issuedAt                DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  company    Company            @relation(fields: [companyId], references: [id])
  salesOrder SalesOrder         @relation(fields: [salesOrderId], references: [id])
  quotation  SalesQuotation?    @relation(fields: [quotationId], references: [id])
  receivable Receivable?        @relation(fields: [receivableId], references: [id])
  items      SalesInvoiceItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([quotationId])
  @@index([status])
  @@index([createdAt])
}

model SalesInvoiceItem {
  id                  String   @id @default(cuid())
  invoiceId           String
  productId           String
  productNameSnapshot String
  productSkuSnapshot  String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id])
  product Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model User {
  id              String     @id @default(cuid())
  companyId       String
  name            String
  email           String     @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company                   Company                  @relation(fields: [companyId], references: [id])
  userRoles                 UserRole[]
  sessions                  Session[]
  auditLogs                 AuditLog[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  leadActivities            LeadActivity[]
  assignedSalesTasks        SalesTask[]              @relation("SalesTaskAssignee")
  createdSalesTasks         SalesTask[]              @relation("SalesTaskCreator")
  changedDealStages         DealStageHistory[]       @relation("DealStageChangedBy")
  closedFinancePeriods      FinancePeriod[]          @relation("FinancePeriodClosedBy")
  createdExpenses           Expense[]                @relation("ExpenseCreatedBy")
  reversedExpenses          Expense[]                @relation("ExpenseReversedBy")
  createdReceivablePayments ReceivablePayment[]      @relation("ReceivablePaymentCreatedBy")
  createdPayablePayments    PayablePayment[]         @relation("PayablePaymentCreatedBy")
  createdJournalReversals   JournalReversal[]        @relation("JournalReversalCreatedBy")
  createdStockLedgerEntries StockLedgerEntry[]
  cashierPosSales           PosSale[]                @relation("PosSaleCashier")
  cashierPosSessions        PosSession[]             @relation("PosSessionCashier")
  submittedPurchaseOrders   PurchaseOrder[]          @relation("PurchaseOrderSubmittedBy")
  approvedPurchaseOrders    PurchaseOrder[]          @relation("PurchaseOrderApprovedBy")
  rejectedPurchaseOrders    PurchaseOrder[]          @relation("PurchaseOrderRejectedBy")

  @@index([companyId])
  @@index([status])
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  key         String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, key])
  @@index([companyId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Vendor {
  id            String       @id @default(cuid())
  companyId     String
  name          String
  code          String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  status        VendorStatus @default(active)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@index([companyId, name])
}

model PurchaseOrder {
  id                  String              @id @default(cuid())
  companyId           String
  vendorId            String
  purchaseOrderNumber String
  vendorNameSnapshot  String
  vendorPhoneSnapshot String?
  vendorEmailSnapshot String?
  status              PurchaseOrderStatus @default(draft)
  subtotal            Decimal             @db.Decimal(12, 2)
  discountAmount      Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal             @db.Decimal(12, 2)
  notes               String?
  submittedAt         DateTime?
  submittedByUserId   String?
  approvedAt          DateTime?
  approvedByUserId    String?
  rejectedAt          DateTime?
  rejectedByUserId    String?
  rejectionReason     String?
  approvalNote        String?
  orderedAt           DateTime?
  receivedAt          DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  company     Company             @relation(fields: [companyId], references: [id])
  vendor      Vendor              @relation(fields: [vendorId], references: [id])
  items       PurchaseOrderItem[]
  submittedBy User?               @relation("PurchaseOrderSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  approvedBy  User?               @relation("PurchaseOrderApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedBy  User?               @relation("PurchaseOrderRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, purchaseOrderNumber])
  @@index([companyId])
  @@index([vendorId])
  @@index([status])
  @@index([companyId, status])
  @@index([submittedByUserId])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id                  String   @id @default(cuid())
  purchaseOrderId     String
  productId           String
  productNameSnapshot String
  productSkuSnapshot  String
  quantity            Int
  unitCost            Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model FinanceAccount {
  id             String               @id @default(cuid())
  companyId      String
  name           String
  code           String
  type           FinanceAccountType
  kind           FinanceAccountKind   @default(general)
  status         FinanceAccountStatus @default(active)
  openingBalance Decimal              @default(0) @db.Decimal(12, 2)
  currentBalance Decimal              @default(0) @db.Decimal(12, 2)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company                  Company             @relation(fields: [companyId], references: [id])
  journalLines             JournalEntryLine[]
  expensesAsCategory       Expense[]           @relation("ExpenseCategoryAccount")
  expensesAsPaidFrom       Expense[]           @relation("ExpensePaidFromAccount")
  receivablePayments       ReceivablePayment[] @relation("ReceivablePaymentAccount")
  payablePayments          PayablePayment[]    @relation("PayablePaymentAccount")
  posSalesAsPaymentAccount PosSale[]           @relation("PosSalePaymentAccount")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([type])
  @@index([kind])
  @@index([status])
}

model JournalEntry {
  id          String             @id @default(cuid())
  companyId   String
  entryNumber String
  entryDate   DateTime           @default(now())
  sourceType  JournalSourceType  @default(manual)
  sourceId    String?
  description String?
  status      JournalEntryStatus @default(draft)
  totalDebit  Decimal            @db.Decimal(12, 2)
  totalCredit Decimal            @db.Decimal(12, 2)
  postedAt    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company                  Company             @relation(fields: [companyId], references: [id])
  lines                    JournalEntryLine[]
  linkedReceivablePayments ReceivablePayment[] @relation("ReceivablePaymentJournalEntry")
  linkedPayablePayments    PayablePayment[]    @relation("PayablePaymentJournalEntry")
  expensePosted            Expense[]           @relation("ExpenseJournalEntry")
  expenseReversals         Expense[]           @relation("ExpenseReversalJournalEntry")
  asOriginalReversal       JournalReversal?    @relation("JournalReversalOriginal")
  asReversalEntry          JournalReversal?    @relation("JournalReversalReversal")

  @@unique([companyId, entryNumber])
  @@index([companyId])
  @@index([status])
  @@index([entryDate])
  @@index([sourceType, sourceId])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal  @default(0) @db.Decimal(12, 2)
  credit         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id])
  account      FinanceAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model Receivable {
  id                   String           @id @default(cuid())
  companyId            String
  salesOrderId         String?          @unique
  customerNameSnapshot String
  amount               Decimal          @db.Decimal(12, 2)
  paidAmount           Decimal          @default(0) @db.Decimal(12, 2)
  status               SettlementStatus @default(open)
  dueDate              DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  company      Company             @relation(fields: [companyId], references: [id])
  salesInvoice SalesInvoice?
  payments     ReceivablePayment[]

  @@index([companyId])
  @@index([status])
  @@index([salesOrderId])
}

model Payable {
  id                 String           @id @default(cuid())
  companyId          String
  purchaseOrderId    String?          @unique
  vendorNameSnapshot String
  amount             Decimal          @db.Decimal(12, 2)
  paidAmount         Decimal          @default(0) @db.Decimal(12, 2)
  status             SettlementStatus @default(open)
  dueDate            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company  Company          @relation(fields: [companyId], references: [id])
  payments PayablePayment[]

  @@index([companyId])
  @@index([status])
  @@index([purchaseOrderId])
}

model FinancePeriod {
  id             String              @id @default(cuid())
  companyId      String
  periodKey      String
  startDate      DateTime
  endDate        DateTime
  status         FinancePeriodStatus @default(open)
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company      Company @relation(fields: [companyId], references: [id])
  closedByUser User?   @relation("FinancePeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, periodKey])
  @@index([companyId])
  @@index([companyId, status])
  @@index([startDate])
  @@index([endDate])
}

model Expense {
  id                     String               @id @default(cuid())
  companyId              String
  expenseNumber          String
  expenseDate            DateTime             @default(now())
  amount                 Decimal              @db.Decimal(12, 2)
  status                 ExpenseStatus        @default(posted)
  method                 FinancePaymentMethod @default(bank_transfer)
  reference              String?
  note                   String?
  categoryAccountId      String
  paidFromAccountId      String
  journalEntryId         String
  reversalJournalEntryId String?
  reversedAt             DateTime?
  createdByUserId        String?
  reversedByUserId       String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  company              Company        @relation(fields: [companyId], references: [id])
  categoryAccount      FinanceAccount @relation("ExpenseCategoryAccount", fields: [categoryAccountId], references: [id])
  paidFromAccount      FinanceAccount @relation("ExpensePaidFromAccount", fields: [paidFromAccountId], references: [id])
  journalEntry         JournalEntry   @relation("ExpenseJournalEntry", fields: [journalEntryId], references: [id])
  reversalJournalEntry JournalEntry?  @relation("ExpenseReversalJournalEntry", fields: [reversalJournalEntryId], references: [id])
  createdByUser        User?          @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reversedByUser       User?          @relation("ExpenseReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, expenseNumber])
  @@index([companyId])
  @@index([status])
  @@index([expenseDate])
  @@index([categoryAccountId])
  @@index([paidFromAccountId])
  @@index([journalEntryId])
  @@index([reversalJournalEntryId])
}

model ReceivablePayment {
  id              String               @id @default(cuid())
  companyId       String
  receivableId    String
  accountId       String?
  journalEntryId  String?
  amount          Decimal              @db.Decimal(12, 2)
  paymentDate     DateTime             @default(now())
  method          FinancePaymentMethod @default(bank_transfer)
  reference       String?
  note            String?
  createdByUserId String?
  createdAt       DateTime             @default(now())

  company       Company         @relation(fields: [companyId], references: [id])
  receivable    Receivable      @relation(fields: [receivableId], references: [id])
  account       FinanceAccount? @relation("ReceivablePaymentAccount", fields: [accountId], references: [id], onDelete: SetNull)
  journalEntry  JournalEntry?   @relation("ReceivablePaymentJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdByUser User?           @relation("ReceivablePaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([receivableId])
  @@index([accountId])
  @@index([journalEntryId])
  @@index([createdByUserId])
  @@index([paymentDate])
  @@index([companyId, paymentDate])
}

model PayablePayment {
  id              String               @id @default(cuid())
  companyId       String
  payableId       String
  accountId       String?
  journalEntryId  String?
  amount          Decimal              @db.Decimal(12, 2)
  paymentDate     DateTime             @default(now())
  method          FinancePaymentMethod @default(bank_transfer)
  reference       String?
  note            String?
  createdByUserId String?
  createdAt       DateTime             @default(now())

  company       Company         @relation(fields: [companyId], references: [id])
  payable       Payable         @relation(fields: [payableId], references: [id])
  account       FinanceAccount? @relation("PayablePaymentAccount", fields: [accountId], references: [id], onDelete: SetNull)
  journalEntry  JournalEntry?   @relation("PayablePaymentJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdByUser User?           @relation("PayablePaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([payableId])
  @@index([accountId])
  @@index([journalEntryId])
  @@index([createdByUserId])
  @@index([paymentDate])
  @@index([companyId, paymentDate])
}

model StockLedgerEntry {
  id              String                @id @default(cuid())
  companyId       String
  productId       String
  type            StockLedgerEntryType
  sourceType      StockLedgerSourceType
  sourceId        String
  quantityDelta   Int
  balanceBefore   Int
  balanceAfter    Int
  note            String?
  createdByUserId String?
  createdAt       DateTime              @default(now())

  company       Company @relation(fields: [companyId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
  createdByUser User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([productId])
  @@index([createdByUserId])
  @@index([sourceType, sourceId])
  @@index([companyId, productId, createdAt])
  @@index([companyId, sourceType, sourceId])
}

model JournalReversal {
  id                     String   @id @default(cuid())
  companyId              String
  originalJournalEntryId String   @unique
  reversalJournalEntryId String   @unique
  reason                 String?
  createdByUserId        String?
  createdAt              DateTime @default(now())

  company              Company      @relation(fields: [companyId], references: [id])
  originalJournalEntry JournalEntry @relation("JournalReversalOriginal", fields: [originalJournalEntryId], references: [id])
  reversalJournalEntry JournalEntry @relation("JournalReversalReversal", fields: [reversalJournalEntryId], references: [id])
  createdByUser        User?        @relation("JournalReversalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdByUserId])
  @@index([createdAt])
}

model Lead {
  id                  String     @id @default(cuid())
  companyId           String
  name                String
  companyName         String?
  email               String?
  phone               String?
  source              String?
  stage               LeadStage  @default(new)
  status              LeadStatus @default(active)
  estimatedValue      Decimal?   @db.Decimal(12, 2)
  expectedCloseDate   DateTime?
  nextFollowUpAt      DateTime?
  notes               String?
  convertedCustomerId String?
  convertedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  company           Company          @relation(fields: [companyId], references: [id])
  convertedCustomer CustomerContact? @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id])
  activities        LeadActivity[]
  deals             Deal[]
  salesTasks        SalesTask[]

  @@index([companyId])
  @@index([stage])
  @@index([status])
  @@index([nextFollowUpAt])
  @@index([companyId, stage])
  @@index([companyId, status])
  @@index([companyId, phone])
  @@index([companyId, email])
}

model CustomerContact {
  id          String         @id @default(cuid())
  companyId   String
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  status      CustomerStatus @default(active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company        Company     @relation(fields: [companyId], references: [id])
  convertedLeads Lead[]      @relation("LeadConvertedCustomer")
  deals          Deal[]
  salesTasks     SalesTask[]

  @@index([companyId])
  @@index([status])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@index([companyId, email])
}

model LeadActivity {
  id        String           @id @default(cuid())
  companyId String
  leadId    String
  userId    String?
  type      LeadActivityType
  note      String
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model PipelineStage {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  name        String
  sortOrder   Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company          Company            @relation(fields: [companyId], references: [id])
  activeDeals      Deal[]
  fromStageHistory DealStageHistory[] @relation("DealStageFrom")
  toStageHistory   DealStageHistory[] @relation("DealStageTo")

  @@unique([companyId, key])
  @@index([companyId])
  @@index([companyId, sortOrder])
  @@index([isActive])
}

model Deal {
  id                String     @id @default(cuid())
  companyId         String
  name              String
  description       String?
  value             Decimal?   @db.Decimal(12, 2)
  probability       Int        @default(50)
  expectedCloseDate DateTime?
  currentStageId    String
  leadId            String?
  customerContactId String?
  status            DealStatus @default(active)
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  archivedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company         Company            @relation(fields: [companyId], references: [id])
  currentStage    PipelineStage      @relation(fields: [currentStageId], references: [id])
  lead            Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerContact CustomerContact?   @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  stageHistory    DealStageHistory[]
  salesTasks      SalesTask[]

  @@index([companyId])
  @@index([currentStageId])
  @@index([status])
  @@index([expectedCloseDate])
  @@index([leadId])
  @@index([customerContactId])
  @@index([companyId, status])
}

model DealStageHistory {
  id              String   @id @default(cuid())
  companyId       String
  dealId          String
  fromStageId     String?
  toStageId       String
  changedByUserId String?
  probability     Int?
  value           Decimal? @db.Decimal(12, 2)
  note            String?
  createdAt       DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id])
  deal          Deal           @relation(fields: [dealId], references: [id])
  fromStage     PipelineStage? @relation("DealStageFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage       PipelineStage  @relation("DealStageTo", fields: [toStageId], references: [id])
  changedByUser User?          @relation("DealStageChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([dealId])
  @@index([toStageId])
  @@index([changedByUserId])
  @@index([createdAt])
}

model SalesTask {
  id                String            @id @default(cuid())
  companyId         String
  dealId            String?
  leadId            String?
  customerContactId String?
  assignedToUserId  String?
  createdByUserId   String?
  title             String
  description       String?
  dueAt             DateTime?
  completedAt       DateTime?
  status            SalesTaskStatus   @default(pending)
  priority          SalesTaskPriority @default(medium)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  deal            Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  assignedToUser  User?            @relation("SalesTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdByUser   User?            @relation("SalesTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([dealId])
  @@index([leadId])
  @@index([customerContactId])
  @@index([assignedToUserId])
  @@index([createdByUserId])
  @@index([dueAt])
  @@index([status])
  @@index([companyId, status])
}
