# Local development example
# Copy this file to .env and replace values for your machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_ai_project?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/erp_ai_project_shadow?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
NODE_ENV="development"

# Production example for hosting providers:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# SESSION_SECRET="use-a-different-long-random-production-secret"
# NODE_ENV="production"
