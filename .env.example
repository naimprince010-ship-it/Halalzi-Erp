# Local development example
# Copy this file to .env and replace values for your machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_ai_project?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/erp_ai_project_shadow?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"
EMAIL_FROM="Halalzi ERP <onboarding@resend.dev>"
RESEND_API_KEY=""

